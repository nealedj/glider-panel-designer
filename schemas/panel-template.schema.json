{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string"
    },
    "outline": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "poly"
        },
        "points": {
          "minItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "bulge": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          }
        },
        "closed": {
          "default": true,
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "kind",
        "points"
      ]
    },
    "bendLines": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "a": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "b": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "a",
          "b"
        ]
      }
    },
    "thickness": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "material": {
      "type": "string"
    },
    "keepOuts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "shape": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "circle"
                  },
                  "cx": {
                    "type": "number"
                  },
                  "cy": {
                    "type": "number"
                  },
                  "d": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "kind",
                  "cx",
                  "cy",
                  "d"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "rect"
                  },
                  "cx": {
                    "type": "number"
                  },
                  "cy": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "h": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "r": {
                    "default": 0,
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "cx",
                  "cy",
                  "w",
                  "h"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "poly"
                  },
                  "points": {
                    "minItems": 3,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "bulge": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ]
                    }
                  },
                  "closed": {
                    "default": true,
                    "type": "boolean",
                    "const": true
                  }
                },
                "required": [
                  "kind",
                  "points"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "label",
          "shape"
        ]
      }
    },
    "canopyClearance": {
      "default": null,
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "availableDepth": {
      "default": {
        "default": null,
        "regions": []
      },
      "type": "object",
      "properties": {
        "default": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "regions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "shape": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "circle"
                      },
                      "cx": {
                        "type": "number"
                      },
                      "cy": {
                        "type": "number"
                      },
                      "d": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "kind",
                      "cx",
                      "cy",
                      "d"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "rect"
                      },
                      "cx": {
                        "type": "number"
                      },
                      "cy": {
                        "type": "number"
                      },
                      "w": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "h": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "r": {
                        "default": 0,
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "kind",
                      "cx",
                      "cy",
                      "w",
                      "h"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "poly"
                      },
                      "points": {
                        "minItems": 3,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            },
                            "bulge": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "x",
                            "y"
                          ]
                        }
                      },
                      "closed": {
                        "default": true,
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "required": [
                      "kind",
                      "points"
                    ]
                  }
                ]
              },
              "depth": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "shape",
              "depth"
            ]
          }
        }
      },
      "required": [
        "default"
      ]
    },
    "fixings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "d": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "x",
          "y",
          "d"
        ]
      }
    },
    "gliderTypes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "inputType": {
          "type": "string",
          "enum": [
            "scan",
            "gridded-mockup",
            "tracing",
            "straight-photo",
            "angled-photo",
            "drawn",
            "measured"
          ]
        },
        "source": {
          "type": "string"
        },
        "rights": {
          "type": "string"
        },
        "accuracyMm": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "type": "string"
        },
        "checks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "a": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              },
              "b": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              },
              "measuredMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "templateMm": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "label",
              "a",
              "b",
              "measuredMm",
              "templateMm"
            ]
          }
        }
      },
      "required": [
        "inputType",
        "source",
        "accuracyMm"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "verified"
      ]
    },
    "verifiedNote": {
      "type": "string"
    },
    "verifiedDate": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "name",
    "outline",
    "thickness",
    "material",
    "provenance",
    "status"
  ]
}
