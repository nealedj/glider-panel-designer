{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "gpd-reviewed-parts"
    },
    "exported": {
      "type": "string"
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "maker": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "instrument",
              "vario",
              "flight-computer",
              "display",
              "radio",
              "transponder",
              "flarm",
              "compass",
              "switch",
              "breaker",
              "fuse",
              "connector",
              "mount",
              "placard",
              "bracket",
              "pneumatic",
              "power",
              "antenna",
              "audio",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "generator": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "unit": {
                  "default": "mm",
                  "type": "string",
                  "enum": [
                    "mm",
                    "deg",
                    "A",
                    "g",
                    "count",
                    "Ah",
                    "V"
                  ]
                }
              },
              "required": [
                "label",
                "value"
              ]
            }
          },
          "front": {
            "type": "object",
            "properties": {
              "cutouts": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "circle"
                        },
                        "cx": {
                          "type": "number"
                        },
                        "cy": {
                          "type": "number"
                        },
                        "d": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "kind",
                        "cx",
                        "cy",
                        "d"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "rect"
                        },
                        "cx": {
                          "type": "number"
                        },
                        "cy": {
                          "type": "number"
                        },
                        "w": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "h": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "r": {
                          "default": 0,
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "kind",
                        "cx",
                        "cy",
                        "w",
                        "h"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "poly"
                        },
                        "points": {
                          "minItems": 3,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "x": {
                                "type": "number"
                              },
                              "y": {
                                "type": "number"
                              },
                              "bulge": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "x",
                              "y"
                            ]
                          }
                        },
                        "closed": {
                          "default": true,
                          "type": "boolean",
                          "const": true
                        }
                      },
                      "required": [
                        "kind",
                        "points"
                      ]
                    }
                  ]
                }
              },
              "bezel": {
                "anyOf": [
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "circle"
                          },
                          "cx": {
                            "type": "number"
                          },
                          "cy": {
                            "type": "number"
                          },
                          "d": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        },
                        "required": [
                          "kind",
                          "cx",
                          "cy",
                          "d"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "rect"
                          },
                          "cx": {
                            "type": "number"
                          },
                          "cy": {
                            "type": "number"
                          },
                          "w": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "h": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "r": {
                            "default": 0,
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "kind",
                          "cx",
                          "cy",
                          "w",
                          "h"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "poly"
                          },
                          "points": {
                            "minItems": 3,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "x": {
                                  "type": "number"
                                },
                                "y": {
                                  "type": "number"
                                },
                                "bulge": {
                                  "type": "number"
                                }
                              },
                              "required": [
                                "x",
                                "y"
                              ]
                            }
                          },
                          "closed": {
                            "default": true,
                            "type": "boolean",
                            "const": true
                          }
                        },
                        "required": [
                          "kind",
                          "points"
                        ]
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "screwHoles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "d": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "d"
                  ]
                }
              },
              "protrusion": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "cutouts",
              "bezel",
              "screwHoles",
              "protrusion"
            ]
          },
          "rear": {
            "type": "object",
            "properties": {
              "body": {
                "anyOf": [
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "circle"
                          },
                          "cx": {
                            "type": "number"
                          },
                          "cy": {
                            "type": "number"
                          },
                          "d": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        },
                        "required": [
                          "kind",
                          "cx",
                          "cy",
                          "d"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "rect"
                          },
                          "cx": {
                            "type": "number"
                          },
                          "cy": {
                            "type": "number"
                          },
                          "w": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "h": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "r": {
                            "default": 0,
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "kind",
                          "cx",
                          "cy",
                          "w",
                          "h"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "poly"
                          },
                          "points": {
                            "minItems": 3,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "x": {
                                  "type": "number"
                                },
                                "y": {
                                  "type": "number"
                                },
                                "bulge": {
                                  "type": "number"
                                }
                              },
                              "required": [
                                "x",
                                "y"
                              ]
                            }
                          },
                          "closed": {
                            "default": true,
                            "type": "boolean",
                            "const": true
                          }
                        },
                        "required": [
                          "kind",
                          "points"
                        ]
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "depth": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bracketPoints": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ]
                }
              }
            },
            "required": [
              "body",
              "depth"
            ]
          },
          "connectors": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "face": {
                  "default": "rear",
                  "type": "string",
                  "enum": [
                    "rear",
                    "left",
                    "right",
                    "top",
                    "bottom"
                  ]
                },
                "clearance": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "pins": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "number": {
                        "type": "string"
                      },
                      "function": {
                        "type": "string"
                      },
                      "signal": {
                        "type": "string",
                        "enum": [
                          "power",
                          "ground",
                          "serial",
                          "bus",
                          "audio",
                          "rf",
                          "switch",
                          "other"
                        ]
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "in",
                          "out",
                          "bidi",
                          "passive"
                        ]
                      }
                    },
                    "required": [
                      "number",
                      "function",
                      "signal"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "type",
                "x",
                "y",
                "pins"
              ]
            }
          },
          "ports": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "pitot",
                    "static",
                    "te",
                    "any"
                  ]
                },
                "fitting": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "kind",
                "fitting",
                "x",
                "y"
              ]
            }
          },
          "power": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "currentA": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "voltage": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "currentA",
                  "voltage"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "ratingA": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "capacityAh": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "weightG": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "datasheet": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "snippet": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "unverified",
                    "verified"
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "snippet",
                "status"
              ]
            }
          },
          "review": {
            "type": "string",
            "enum": [
              "unverified",
              "verified"
            ]
          },
          "offPanel": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "version",
          "maker",
          "model",
          "category",
          "front",
          "rear",
          "weightG",
          "review"
        ]
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "part",
          "path",
          "reason"
        ]
      }
    }
  },
  "required": [
    "kind",
    "exported",
    "parts",
    "excluded"
  ]
}
